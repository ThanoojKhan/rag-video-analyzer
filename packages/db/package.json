{
  "name": "@rag/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "lint": "eslint . --ext .ts",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "migrate:status": "dotenv -e ../../.env -- prisma migrate status",
    "prisma:generate": "dotenv -e ../../.env -- prisma generate",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.11.1"
  },
  "devDependencies": {
    "dotenv-cli": "^7.4.4",
    "prisma": "^5.11.1",
    "typescript": "^5.6.0"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  }
}
